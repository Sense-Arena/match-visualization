{
  "name": "@sensearena/mv",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sense-Arena/match-visualization"
  },
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist",
    "imgs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/@sa-mv.umd.cjs",
  "module": "./dist/@sa-mv.es.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/@sa-mv.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/@sa-mv.umd.cjs"
      }
    },
    "./theme.css": "./dist/mv.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "build:test": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build -m test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "prepack": "npm run build",
    "test": "npm run test:package",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "test:storybook": "node scripts/test-storybook.mjs"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "@react-spring/web": "10.1.2",
    "@sensearena/ui": "0.3.1",
    "@storybook/addon-links": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/recipes": "0.5.7",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.2.1",
    "effector": "23.4.4",
    "effector-react": "23.3.0",
    "perfect-arrows": "0.3.7",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup-plugin-visualizer": "7.1.2",
    "storybook": "10.6.5",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "unplugin-dts": "1.1.2",
    "vite": "8.3.6"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.x",
    "@dnd-kit/modifiers": "9.x",
    "@dnd-kit/sortable": "10.x",
    "@dnd-kit/utilities": "3.x",
    "@emotion/react": "11.x",
    "@emotion/styled": "11.x",
    "@mui/material": "7.x || ^9.5.0",
    "@react-spring/web": "10.x",
    "@sensearena/ui": "^0.3.1",
    "@vanilla-extract/css": "1.x",
    "@vanilla-extract/recipes": "0.x",
    "effector": "23.x",
    "effector-react": "23.x",
    "perfect-arrows": "0.x",
    "react": "19.x",
    "react-dom": "19.x"
  }
}
